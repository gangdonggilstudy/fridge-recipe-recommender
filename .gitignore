# final_term 전용 .gitignore
# (상위 ../../../.gitignore 가 Python/IDE/OS 공통 패턴 처리)

# ── 비밀 정보 ──
.env
.env.local
.streamlit/secrets.toml

# ── 사용자 데이터 (커밋 금지) ──
data/app.db
data/app.db-journal
data/app.db-wal
data/app.db-shm

# ── 레시피 DB는 git 추적 (read-only 배포용)
# data/recipes.db 는 추적함

# ── Streamlit 캐시 ──
.streamlit/cache/

# ── ML 모델 산출물 (로컬 학습 결과 + 사용자별 디렉토리 전부) ──
models/

# ── 테스트 캐시 ──
.pytest_cache/

# ── PDF 빌드 산출물 ──
pdf_output/
html_output/
