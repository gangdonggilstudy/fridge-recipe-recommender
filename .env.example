# 이 파일을 .env로 복사한 후 실제 키 값을 입력하세요
# cp .env.example .env (Linux/macOS)
# copy .env.example .env (Windows)

# ── 날씨 API (필수) ──
# https://openweathermap.org/api 에서 발급
WEATHER_API_KEY=your_openweathermap_api_key_here
# 사용자 위치 미해결 시(IP 추정 실패·신규 사용자 첫 호출 등) 최후 폴백 도시
WEATHER_CITY=Seoul

# ── LLM API (선택) ──
# gemini | openai 중 선택
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here

# LLM 모델·튜닝 (선택, 미설정 시 기본값 사용 — narrator.py DEFAULT_*)
# LLM_GEMINI_MODEL=gemini-2.0-flash
# LLM_OPENAI_MODEL=gpt-4o-mini
# LLM_TEXT_TIMEOUT_SEC=10
# LLM_VISION_TIMEOUT_SEC=30
# LLM_MAX_TOKENS_TEXT=200
# LLM_MAX_TOKENS_VISION=500

# 영수증 OCR (Gemini 비전, 선택·민감 입력). LLM 키 있어도 명시 옵트인 필요.
# true 일 때만 냉장고에 '영수증으로 추가' 노출. 기본 off (메인 데모 무영향).
RECEIPT_OCR_ENABLED=false

# ── DB 경로 (기본값 사용 시 변경 불필요) ──
RECIPES_DB_PATH=data/recipes.db
APP_DB_PATH=data/app.db
MODEL_REGISTRY_DIR=models

# ── 운영자 권한 (선택) ──
# 콤마 구분 사용자 ID 리스트. 비워두면 운영자 없음 → 관리자 페이지 접근 불가.
# 예: ADMIN_USER_IDS=admin,demo_admin
ADMIN_USER_IDS=

# ── 음성 입력 STT (선택) ──
# faster-whisper 가 설치되어 있어야 동작. 미설치 시 자동 비활성화.
# false 로 설정하면 패키지 설치되어 있어도 비활성화.
STT_ENABLED=true
STT_MODEL=small       # tiny / base / small / medium / large
STT_DEVICE=cpu        # cpu / cuda
STT_COMPUTE_TYPE=int8 # int8 / float16 / float32
